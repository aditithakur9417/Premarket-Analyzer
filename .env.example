# Premarket Desk
SECRET_KEY=replace-with-long-random-string
ADMIN_PASSWORD=changeme
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP bootstrap (also editable in Settings UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO=
USE_LLM_DEFAULT=true
SCHEDULE_CRON=15 8 * * mon-fri

# --- Free LLM (pick one; auto tries in order) ---
# LLM_PROVIDER=auto | ollama | groq | gemini | openai
LLM_PROVIDER=auto

# 1) Self-hosted Ollama (fully free) — used by docker compose service "ollama"
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 2) Groq free tier — https://console.groq.com/keys  (no card required for free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# 3) Google Gemini free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 4) Optional OpenAI-compatible free endpoint (e.g. OpenRouter free models)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free
